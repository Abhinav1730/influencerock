[Unit]
Description=Influence Rock hourly delegate email sender
After=network-online.target influencerock-1.service

[Service]
Type=oneshot
User=influencerock-1
Group=influencerock-1
WorkingDirectory=/srv/influencerock-1-current
Environment=NODE_ENV=production
Environment=IR_DATA_DIR=/srv/influencerock-1/data
EnvironmentFile=/etc/influencerock-1.env
ExecStart=/usr/bin/node --conditions=react-server --import tsx scripts/pipeline-worker.ts send
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/influencerock-1/data
UMask=0077
