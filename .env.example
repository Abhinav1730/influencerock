# Private storage, persistent across releases. Never use NEXT_PUBLIC for secrets.
IR_DATA_DIR=/srv/influencerock-1/data
SMARTMEET_URL=https://smartmeet.org
IR_SMARTMEET_API_URL=http://127.0.0.1:4102
# Must match INFLUENCE_ROCK_BRIDGE_KEY on the SmartMeet backend (>=32 characters).
SMARTMEET_BRIDGE_KEY=
SMARTMEET_DELEGATE_TIMEZONE=Asia/Kolkata
# Optional legacy human delegate mailbox mapping; AI delegates do not need inboxes.
SMARTMEET_TEST_DELEGATE_EMAIL=
SMARTMEET_DELEGATE_EMAILS={}

# Verified sending domain; addresses are assigned once per stable delegate identity.
RESEND_API_KEY=
IR_EMAIL_DOMAIN=influencerock.com
# Signing secret for the /api/webhooks/resend endpoint.
RESEND_WEBHOOK_SECRET=
IR_ADMIN_HOST=admin.influencerock.com
# Salted scrypt verifier: 16-byte salt hex:64-byte hash hex.
# Input is normalized-email:password; never store the password here.
IR_ADMIN_PASSWORD_SCRYPT=

# Put these and IR_DATA_DIR in the separate preparation-worker env file.
IR_HERMES_HOME=/var/lib/influencerock-agent
IR_HERMES_PYTHON=/usr/local/lib/hermes-agent/venv/bin/python
IR_HERMES_MODEL=gpt-5.6-sol

# Delegated read-only master admin connection; exact issuer -> SPKI public PEM JSON.
# Private signing keys belong only to the master portal.
ADMIN_DELEGATION_KEYS={}
ADMIN_DELEGATION_AUDIENCE=ir-admin

# Optional private outreach dataset; default retains the existing deployment path.
# Keep the contact JSON outside Git and public assets.
IR_PRESS_CONTACTS_FILE=/private/path/press-contacts.json
OUTREACH_USERNAME=
OUTREACH_PASSWORD_HASH=
OUTREACH_SESSION_SECRET=
